# Backend API base URL (NestJS server)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public base URL used to view uploaded diary/profile photos (S3 bucket or CDN origin).
NEXT_PUBLIC_MEDIA_BASE_URL=https://maru-media.s3.ap-northeast-2.amazonaws.com

# Optional: Playwright base URL override for E2E runs
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
