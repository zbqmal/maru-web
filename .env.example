# Backend API base URL (NestJS server)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Readable CDN base URL for profile images, preserving the profiles/{userId}/{file} key.
# The profile API returns a storage key, not a signed GET URL. Without this setting,
# saved avatars show initials. Do not use a presigned PUT URL or expose AWS credentials.
# Configure CDN read access separately; do not make private diary photos public.
NEXT_PUBLIC_PROFILE_IMAGE_BASE_URL=

# Optional: Playwright base URL override for E2E runs
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
